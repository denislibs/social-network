DATABASE_URL=postgres://vk:vk@localhost:5432/vk
DATABASE_URL_TEST=postgres://vk:vk@localhost:5432/vk_test
REDIS_URL=redis://localhost:6379
REDIS_DB_TEST=1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=vk-media
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# `Secure` flag on the session cookie. Keep 0 for plain-HTTP local dev — a Secure cookie is
# dropped by the browser over http://, so login silently stops working. Set to 1 in every
# deployment served over TLS.
COOKIE_SECURE=0
PUBLIC_ORIGIN=http://localhost:8080
SEED_DEMO_PASSWORD=demo1234
